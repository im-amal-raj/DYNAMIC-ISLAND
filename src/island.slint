import { HorizontalBox, VerticalBox, ListView, ScrollView, Slider, LineEdit } from "std-widgets.slint";
import { Theme } from "ui/theme.slint";
import { IslandPill } from "ui/components/island_pill.slint";
import { AnimatedIcon } from "ui/components/animated_icon.slint";
import { GlassCard } from "ui/components/glass_card.slint";
import { CircularProgress } from "ui/components/circular_progress.slint";

// Import Modular V2 Panels
import { Dock } from "ui/panels/dock.slint";
import { CompactPanel } from "ui/panels/compact.slint";
import { MediaPanel } from "ui/panels/media.slint";
import { ClipboardPanel } from "ui/panels/clipboard.slint";
import { NotificationPanel } from "ui/panels/notification.slint";
import { NotificationHistoryPanel } from "ui/panels/notification_history.slint";
import { AppLauncherPanel } from "ui/panels/app_launcher.slint";
import { TodoPanel } from "ui/panels/todo/todo_panel.slint";
import { CalendarView } from "ui/panels/todo/calendar.slint";
import { SysMonitorPanel } from "ui/panels/sys_monitor/sys_monitor_panel.slint";
import { SysControlsPanel } from "ui/panels/controls/controls_panel.slint";
import { SystemTrayPanel } from "ui/panels/system_tray/system_tray_panel.slint";

import { IslandSection, TaskItem, CalendarDay, WifiNetwork, BluetoothDevice, AudioDevice, ClipItem, NotifItem, AppItem, MediaState, HardwareStats } from "ui/types.slint";
export { IslandSection, TaskItem, CalendarDay, WifiNetwork, BluetoothDevice, AudioDevice, ClipItem, NotifItem, AppItem, MediaState, HardwareStats }


export component UltimateDynamicIsland inherits Window {
    // Canvas dimensions mapping
    in-out property <IslandSection> active-section: IslandSection.Compact;
    in-out property <length> target-width: 220px;
    in-out property <length> target-height: 42px;
    in-out property <bool> right-pill-hovered: false;
    in-out property <bool> in-date-picker-mode: false;
    in-out property <string> draft-task-text: "";
    in-out property <bool> chime-on-due: true;
    changed is-playing => {
        if (active-section == IslandSection.Compact) {
            root.target-width = root.is-playing ? (root.right-pill-hovered ? 400px : 256px) : 220px;
        }
    }
    changed right-pill-hovered => {
        if (active-section == IslandSection.Compact) {
            root.target-width = root.is-playing ? (root.right-pill-hovered ? 400px : 256px) : 220px;
        }
    }
    
    changed active-section => {
        if (active-section == IslandSection.Compact) {
            root.target-width = root.is-playing ? (root.right-pill-hovered ? 400px : 256px) : 220px;
            root.target-height = 42px;
        } else if (active-section == IslandSection.Media) {
            root.target-width = 380px;
            root.target-height = 210px;
        } else if (active-section == IslandSection.Clipboard) {
            root.target-width = 380px;
            root.target-height = 275px;
        } else if (active-section == IslandSection.Notification) {
            root.target-width = 380px;
            root.target-height = 110px;
        } else if (active-section == IslandSection.SysControls) {
            root.target-width = 380px;
            root.target-height = 260px;
        } else if (active-section == IslandSection.AppLauncher) {
            root.target-width = 380px;
            root.target-height = 275px;
            app_launcher_panel.focus_launcher();
        } else if (active-section == IslandSection.SystemTray) {
            root.target-width = 380px;
            root.target-height = 155px;
            tray_panel.focus_tray();
        } else if (active-section == IslandSection.NotificationHistory) {
            root.target-width = 380px;
            root.target-height = 275px;
        } else if (active-section == IslandSection.TodoManager) {
            root.target-width = 420px;
            root.target-height = 335px;
        } else if (active-section == IslandSection.CalendarView) {
            root.target-width = 380px;
            root.target-height = 375px;
        } else if (active-section == IslandSection.SysMonitor) {
            root.target-width = 380px;
            root.target-height = 340px;
        }
        if (active-section != IslandSection.Compact && active-section != IslandSection.Notification) {
            root.last-expanded-section = active-section;
        }
        root.active-section-changed(active-section);
    }
    
    property <IslandSection> last-expanded-section: IslandSection.TodoManager;
    
    property <length> animated-width: target-width;
    property <length> animated-height: target-height;
    animate animated-width { duration: Theme.standard-duration; easing: Theme.standard-easing; }
    animate animated-height { duration: Theme.standard-duration; easing: Theme.standard-easing; }
    
    width: 420px;
    height: animated-height;
    background: transparent;
    no-frame: true;
    
    property <IslandSection> pre-notification-section: IslandSection.Compact;
    Timer {
        interval: 5000ms;
        running: root.active-section == IslandSection.Notification;
        triggered => {
            root.active-section = root.pre-notification-section;
        }
    }
    
    property <angle> art-rotation: 0deg;
    Timer {
        interval: 16ms;
        running: root.is-playing;
        triggered => {
            root.art-rotation += 1deg;
        }
    }
    
    // Core Engine Bindings (Injected directly by Rust threads)
    in property <MediaState> media-state;
    in-out property <bool> is-playing: false;
    
    in property <HardwareStats> hardware-stats;
    
    in property <[ClipItem]> clipboard-history: [];
    in property <[NotifItem]> notif-history: [];
    in property <[AppItem]> app-results: [];
    in property <[TaskItem]> active-tasks: [];
    in property <[CalendarDay]> calendar-days-grid: [];
    in property <string> current-month-year-label: "July 2026";
    in property <string> current-date-string: "Jul 7 Tue";
    in property <string> current-time-string: "20:26";
    in-out property <string> selected-date-filter: "";
    in-out property <string> selected-priority: "Medium";
    in-out property <string> todo-filter: "Pending";
    in-out property <bool> show-power-confirm: false;
    in-out property <string> pending-power-action: "";
    
    // Notification Engine Bindings
    in property <string> notif-app-name: "";
    in property <string> notif-summary: "";
    in property <string> notif-body: "";
    in property <bool> has-notif-icon: false;
    in property <image> notif-icon;
    
    // Live Activity / Privacy Contexts
    in property <bool> camera-active: false;
    in property <bool> mic-active: false;
    in property <bool> has-new-notification: false;
    in property <image> peek-notif-icon;
    in property <string> peek-notif-summary: "";
    
    // System Status Bindings
    in property <[AppItem]> system-tray-apps: [];
    in property <[WifiNetwork]> wifi-networks: [];
    in property <[BluetoothDevice]> bluetooth-devices: [];
    in-out property <string> active-connectivity-tab: "wifi";
    in property <bool> wifi-enabled: false;
    in property <bool> bluetooth-enabled: false;
    in property <string> ethernet-name: "";
    in-out property <float> volume-level: 50.0;
    in property <float> mic-level: 50.0;
    in property <float> brightness-level: 50.0;
    
    in-out property <string> active-mixer-tab: "output";
    in property <[AudioDevice]> audio-sinks: [];
    in property <[AudioDevice]> audio-sources: [];
    
    // Callbacks to pass UI actions straight down to C/Rust speed loops
    callback change-volume(bool);
    callback set-volume(float);
    callback set-mic-volume(float);
    callback set-brightness(float);
    callback set-default-audio(string); // passed the node ID
    callback connect-wifi(string, string);
    callback disconnect-wifi();
    callback scan-wifi();
    callback toggle-wifi(bool);
    callback scan-bluetooth();
    callback toggle-bluetooth(bool);
    callback connect-bluetooth(string);
    callback disconnect-bluetooth(string);
    
    callback activate-tray-item(string);
    callback dispatch-app-launcher(string);
    callback media-action(string);
    callback paste-clip(string);
    callback cycle-tab(int);
    callback clear-clipboard();
    callback search-clipboard(string);
    callback erase-clip(string);
    callback clear-notif-history();
    callback search-apps(string);
    callback launch-app(string);
    callback power-action(string);
    callback request-window-focus();
    
    callback toggle-task-completion(int);
    callback reschedule-task(int, string);
    callback filter-tasks-by-date(string);
    callback play-alert-sound();
    
    callback todo-filter-changed(string);
    callback delete-task(int);
    
    callback add-task(string, string, string);
    callback clear-completed-tasks();
    callback change-month-offset(int);
    callback active-section-changed(IslandSection);
    
    pure function section_index(sec: IslandSection) -> int {
        if (sec == IslandSection.Compact) { return 0; }
        if (sec == IslandSection.Media) { return 1; }
        if (sec == IslandSection.Clipboard) { return 2; }
        if (sec == IslandSection.Notification) { return 3; }
        if (sec == IslandSection.SysControls) { return 4; }
        if (sec == IslandSection.AppLauncher) { return 5; }
        if (sec == IslandSection.SystemTray) { return 6; }
        if (sec == IslandSection.NotificationHistory) { return 7; }
        if (sec == IslandSection.TodoManager) { return 8; }
        if (sec == IslandSection.CalendarView) { return 9; }
        if (sec == IslandSection.SysMonitor) { return 10; }
        return 0;
    }
    
    property <int> active-index: root.section_index(root.active-section);
    
    title: "dynamic-island";

    IslandPill {
        width: animated-width;
        height: 100%;
        x: (parent.width - self.width) / 2;
        background: root.is-playing && root.active-section == IslandSection.Compact ? transparent : Theme.glass-gradient;
        border-color: root.is-playing && root.active-section == IslandSection.Compact ? transparent : Theme.border-gradient;
        border-width: root.is-playing && root.active-section == IslandSection.Compact ? 0px : 1px;

        // Global Interaction Layer
        global_ta := TouchArea {
            width: 100%; height: 100%;
            
            // Click to close/toggle if expanded
            clicked => {
                if (root.active-section == IslandSection.Compact) {
                    if (root.is-playing) {
                        root.active-section = IslandSection.Media;
                    } else if (root.has-new-notification) {
                        root.active-section = IslandSection.NotificationHistory;
                    } else {
                        root.active-section = root.last-expanded-section;
                    }
                } else if (root.active-section != IslandSection.Compact) {
                    root.active-section = IslandSection.Compact;
                }
            }
        }

        // Panel 0: Compact Mode Panel
        if root.active-section == IslandSection.Compact : CompactPanel {
            is-playing: root.is-playing;
            has-new-notification: root.has-new-notification;
            hardware-stats: root.hardware-stats;
            current-date-string: root.current-date-string;
            current-time-string: root.current-time-string;
            peek-notif-summary: root.peek-notif-summary;
            peek-notif-icon: root.peek-notif-icon;
            media-state: root.media-state;
            art-rotation: root.art-rotation;
            active-section <=> root.active-section;
            right-pill-hovered <=> root.right-pill-hovered;
        }

        // Panel 1: Media Player Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.Media ? 0px : (root.active-index > 1 ? -40px : 40px);
            opacity: root.active-section == IslandSection.Media ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            MediaPanel {
                media-state: root.media-state;
                is-playing <=> root.is-playing;
                art-rotation: root.art-rotation;
                volume-level <=> root.volume-level;
                
                set-volume(val) => { root.set-volume(val); }
                media-action(action) => { root.media-action(action); }
            }
        }

        // Panel 2: Clipboard Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.Clipboard ? 0px : (root.active-index > 2 ? -40px : 40px);
            opacity: root.active-section == IslandSection.Clipboard ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            ClipboardPanel {
                clipboard-history: root.clipboard-history;
                clear-clipboard() => { root.clear-clipboard(); }
                search-clipboard(query) => { root.search-clipboard(query); }
                paste-clip(id) => { root.paste-clip(id); }
                erase-clip(id) => { root.erase-clip(id); }
            }
        }

        // Panel 3: Inbound Banner Notification Panel
        if root.active-section == IslandSection.Notification : NotificationPanel {
            has-notif-icon: root.has-notif-icon;
            notif-icon: root.notif-icon;
            notif-app-name: root.notif-app-name;
            notif-summary: root.notif-summary;
            notif-body: root.notif-body;
            active-section <=> root.active-section;
        }

        // Panel 4: System Controls Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.SysControls ? 0px : (root.active-index > 4 ? -40px : 40px);
            opacity: root.active-section == IslandSection.SysControls ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            SysControlsPanel {
                active-connectivity-tab <=> root.active-connectivity-tab;
                wifi-enabled: root.wifi-enabled;
                wifi-networks: root.wifi-networks;
                bluetooth-enabled: root.bluetooth-enabled;
                bluetooth-devices: root.bluetooth-devices;
                volume-level: root.volume-level;
                audio-sinks: root.audio-sinks;
                mic-level: root.mic-level;
                audio-sources: root.audio-sources;
                brightness-level: root.brightness-level;
                toggle-wifi(val) => { root.toggle-wifi(val); }
                scan-wifi() => { root.scan-wifi(); }
                disconnect-wifi() => { root.disconnect-wifi(); }
                connect-wifi(ssid, pass) => { root.connect-wifi(ssid, pass); }
                toggle-bluetooth(val) => { root.toggle-bluetooth(val); }
                scan-bluetooth() => { root.scan-bluetooth(); }
                disconnect-bluetooth(mac) => { root.disconnect-bluetooth(mac); }
                connect-bluetooth(mac) => { root.connect-bluetooth(mac); }
                set-volume(val) => { root.set-volume(val); }
                set-mic-volume(val) => { root.set-mic-volume(val); }
                set-default-audio(id) => { root.set-default-audio(id); }
                set-brightness(val) => { root.set-brightness(val); }
            }
        }

        // Panel 5: App Launcher Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.AppLauncher ? 0px : (root.active-index > 5 ? -40px : 40px);
            opacity: root.active-section == IslandSection.AppLauncher ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }
            
            app_launcher_panel := AppLauncherPanel {
                app-results: root.app-results;
                search-apps(query) => { root.search-apps(query); }
                launch-app(cmd) => { 
                    root.launch-app(cmd);
                    root.active-section = IslandSection.Compact;
                }
            }
        }

        // Panel 6: System Tray Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.SystemTray ? 0px : (root.active-index > 6 ? -40px : 40px);
            opacity: root.active-section == IslandSection.SystemTray ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            tray_panel := SystemTrayPanel {
                system-tray-apps: root.system-tray-apps;
                pending-power-action <=> root.pending-power-action;
                show-power-confirm <=> root.show-power-confirm;
                power-action(action) => { root.power-action(action); }
                activate-tray-item(id) => { root.activate-tray-item(id); }
            }
        }

        // Panel 7: Notification History Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.NotificationHistory ? 0px : (root.active-index > 7 ? -40px : 40px);
            opacity: root.active-section == IslandSection.NotificationHistory ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            NotificationHistoryPanel {
                notif-history: root.notif-history;
                clear-notif-history() => { root.clear-notif-history(); }
            }
        }

        // Panel 8: Todo Manager Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.TodoManager ? 0px : (root.active-index > 8 ? -40px : 40px);
            opacity: root.active-section == IslandSection.TodoManager ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            todo_panel := TodoPanel {
                current-month-year-label: root.current-month-year-label;
                active-tasks: root.active-tasks;
                draft-task-text <=> root.draft-task-text;
                chime-on-due <=> root.chime-on-due;
                active-section <=> root.active-section;
                in-date-picker-mode <=> root.in-date-picker-mode;
                todo-filter <=> root.todo-filter;
                toggle-task-completion(id) => { root.toggle-task-completion(id); }
                play-alert-sound() => { root.play-alert-sound(); }
                delete-task(id) => { root.delete-task(id); }
                clear-completed-tasks() => { root.clear-completed-tasks(); }
                add-task(title, date, priority) => { root.add-task(title, date, priority); }
                todo-filter-changed(filter) => { root.todo-filter-changed(filter); }
                open-calendar() => { 
                    root.in-date-picker-mode = true;
                    root.active-section = IslandSection.CalendarView;
                }
            }
        }

        // Panel 9: Calendar View Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.CalendarView ? 0px : (root.active-index > 9 ? -40px : 40px);
            opacity: root.active-section == IslandSection.CalendarView ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            CalendarView {
                current-month-year-label: root.current-month-year-label;
                calendar-days-grid: root.calendar-days-grid;
                selected-date-filter <=> root.selected-date-filter;
                in-date-picker-mode <=> root.in-date-picker-mode;
                change-month-offset(offset) => { root.change-month-offset(offset); }
                go-back() => { 
                    root.active-section = IslandSection.TodoManager; 
                }
                date-selected(date) => {
                    if (root.in-date-picker-mode) {
                        root.draft-task-text = root.draft-task-text + " @" + date;
                        root.active-section = IslandSection.TodoManager;
                        root.in-date-picker-mode = false;
                        todo_panel.focus_input();
                    } else {
                        root.selected-date-filter = date;
                        root.filter-tasks-by-date(date);
                    }
                }
            }
        }

        // Panel 10: System Monitor/Health Panel
        Rectangle {
            width: 100%; height: 100%;
            x: root.active-section == IslandSection.SysMonitor ? 0px : (root.active-index > 10 ? -40px : 40px);
            opacity: root.active-section == IslandSection.SysMonitor ? 1.0 : 0.0;
            visible: self.opacity > 0.05;
            animate x { duration: 240ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }
            animate opacity { duration: 200ms; easing: ease-out; }

            SysMonitorPanel {
                hardware-stats: root.hardware-stats;
            }
        }

        // Bottom Navigation Dock
        if root.active-section != IslandSection.Compact && root.active-section != IslandSection.Notification : Dock {
            active-section <=> root.active-section;
            request-window-focus() => { root.request-window-focus(); }
            
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 4px;
        }
    }
}
