// PURPOSE: Central design system tokens (colors, typography, spacing, motion)
// INPUTS: None (global export)
// USED BY: All UI components and panels across rust-island

export global Theme {
    // V3 Theme: Restrained Elegance (Apple-style monochrome)
    
    // Surface Tokens (pure black pill, subtly elevated cards)
    in-out property <color> surface-primary: #000000;
    in-out property <color> surface-elevated: rgba(28, 28, 30, 1.0); // iOS systemGray6
    in-out property <color> surface-overlay: rgba(44, 44, 46, 1.0); // iOS systemGray5
    in-out property <brush> glass-gradient: @linear-gradient(180deg, #000000 0%, #000000 100%);
    in-out property <color> border-color: rgba(255, 255, 255, 0.08);
    in-out property <brush> border-gradient: @linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.04) 100%);

    // Card Surface Tokens
    in-out property <color> card-surface: rgba(255, 255, 255, 0.05);
    in-out property <color> card-surface-hover: rgba(255, 255, 255, 0.10);
    in-out property <color> card-surface-active: rgba(255, 255, 255, 0.15);
    in-out property <color> card-border: rgba(255, 255, 255, 0.10);
    in-out property <color> card-border-hover: rgba(255, 255, 255, 0.15);

    // Text & Icon Tokens (iOS Dark Mode exactly)
    in-out property <color> text-primary: rgba(255, 255, 255, 1.0);
    in-out property <color> text-secondary: rgba(235, 235, 245, 0.6);
    in-out property <color> text-tertiary: rgba(235, 235, 245, 0.3);

    // Semantic Colors (iOS Dark Mode official values, used ONLY for meaning)
    in-out property <color> color-red: #ff453a;       // Destructive, errors
    in-out property <color> color-orange: #ff9f0a;    // Warnings, medium priority
    in-out property <color> color-green: #30d158;     // Success, completion, connected
    in-out property <color> color-blue: #0a84ff;      // Links, info, selection
    in-out property <color> color-indigo: #5e5ce6;    // Special/rare accent
    in-out property <color> color-teal: #64d2ff;      // System metrics secondary

    // Spacing scale
    in-out property <length> spacing-xs: 4px;
    in-out property <length> spacing-sm: 8px;
    in-out property <length> spacing-md: 12px;
    in-out property <length> spacing-lg: 16px;
    in-out property <length> spacing-xl: 20px;

    in-out property <length> panel-padding: 16px;
    in-out property <length> panel-padding-bottom: 48px;

    in-out property <length> card-radius: 12px;
    in-out property <length> card-radius-small: 8px;
    in-out property <length> pill-radius: 21px;

    in-out property <length> icon-size-sm: 14px;
    in-out property <length> icon-size-md: 18px;
    in-out property <length> icon-size-lg: 24px;
    in-out property <length> touch-target-min: 32px;

    // Fluid Motion System (Calibrated Apple SwiftUI Spring: response=0.35s, damping=0.75)
    in-out property <duration> micro-duration: 120ms;
    in-out property <easing> micro-easing: ease-out;

    in-out property <duration> standard-duration: 300ms;
    in-out property <easing> standard-easing: cubic-bezier(0.16, 1.0, 0.3, 1.0);

    in-out property <duration> dramatic-duration: 350ms;
    in-out property <easing> dramatic-easing: cubic-bezier(0.16, 1.0, 0.3, 1.028); // 2.8% physics overshoot

    // Legacy names (alias to standard/micro to maintain compatibility during refactor)
    in-out property <duration> spring-duration: 300ms;
    in-out property <easing> spring-easing: cubic-bezier(0.16, 1.0, 0.3, 1.0);
    
    in-out property <duration> fade-duration: 120ms;
    in-out property <easing> fade-easing: ease-out;
}
