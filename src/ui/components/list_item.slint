// PURPOSE: Interactive list row with primary/secondary text and trailing widget
// INPUTS: title (string), subtitle (string), icon (image), is-selected (bool)
// USED BY: clipboard.slint, base_device_list_tab.slint, app_launcher.slint

import { Theme } from "../theme.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

// PURPOSE: Reusable list row for devices, apps, or tasks
// INPUTS: icon, title, subtitle, status, is-active, clicked()
// USED BY: WiFi, Bluetooth, Audio, Notification History
export component ListItem inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> status-text;
    in property <color> status-color: Theme.text-tertiary;
    in property <bool> is-active: false;
    callback clicked;
    
    min-height: 44px;
    border-radius: Theme.card-radius-small;
    background: ta.has-hover ? Theme.card-surface-hover : Theme.card-surface;
    border-width: 1px;
    border-color: root.is-active ? Theme.card-border-hover : (ta.has-hover ? Theme.card-border-hover : Theme.card-border);
    animate background, border-color { duration: Theme.micro-duration; }
    
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    
    HorizontalBox {
        padding: Theme.spacing-sm;
        spacing: Theme.spacing-md;
        alignment: space-between;
        
        HorizontalLayout {
            spacing: Theme.spacing-md;
            alignment: start;
            
            Rectangle {
                width: 28px; height: 28px;
                border-radius: 6px;
                background: root.is-active ? rgba(10, 132, 255, 0.15) : rgba(255, 255, 255, 0.06);
                border-width: 1px;
                border-color: root.is-active ? rgba(10, 132, 255, 0.3) : Theme.border-color;
                Image {
                    width: 14px; height: 14px;
                    source: root.icon;
                    colorize: root.is-active ? Theme.color-blue : Theme.text-secondary;
                }
            }
            
            VerticalLayout {
                spacing: Theme.spacing-xs;
                alignment: center;
                Text { text: root.title; color: Theme.text-primary; font-size: 13px; font-weight: 700; overflow: elide; }
                if root.subtitle != "" : Text { text: root.subtitle; color: Theme.text-secondary; font-size: 11px; overflow: elide; }
            }
        }
        
        if root.status-text != "" : VerticalLayout {
            alignment: center;
            Text { text: root.status-text; color: root.is-active ? Theme.color-blue : root.status-color; font-size: 11px; font-weight: 600; }
        }
    }
}
