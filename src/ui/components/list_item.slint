import { Theme } from "../theme.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

// PURPOSE: Reusable list row for devices, apps, or tasks
// INPUTS: icon, title, subtitle, status, is-active, clicked()
// USED BY: WiFi, Bluetooth, Audio, Notification History
export component ListItem inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> status-text;
    in property <color> status-color: Theme.text-tertiary;
    in property <bool> is-active: false;
    callback clicked;
    
    height: 44px;
    border-radius: Theme.card-radius-small;
    background: ta.has-hover ? Theme.card-surface-hover : Theme.card-surface;
    border-width: 1px;
    border-color: root.is-active ? Theme.color-blue : (ta.has-hover ? Theme.card-border-hover : Theme.card-border);
    animate background, border-color { duration: Theme.micro-duration; }
    
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    
    HorizontalBox {
        padding: Theme.spacing-sm;
        spacing: Theme.spacing-md;
        alignment: space-between;
        
        HorizontalLayout {
            spacing: Theme.spacing-md;
            alignment: start;
            
            Rectangle {
                width: 28px; height: 28px;
                border-radius: 6px;
                background: root.is-active ? Theme.color-blue : rgba(255, 255, 255, 0.1);
                Image {
                    width: 14px; height: 14px;
                    source: root.icon;
                    colorize: root.is-active ? Theme.surface-primary : Theme.text-secondary;
                }
            }
            
            VerticalBox {
                spacing: 2px;
                alignment: center;
                Text { text: root.title; color: root.is-active ? Theme.color-blue : Theme.text-primary; font-size: 13px; font-weight: 700; overflow: elide; }
                if root.subtitle != "" : Text { text: root.subtitle; color: Theme.text-secondary; font-size: 11px; overflow: elide; }
            }
        }
        
        if root.status-text != "" : VerticalBox {
            alignment: center;
            Text { text: root.status-text; color: root.status-color; font-size: 11px; font-weight: 600; }
        }
    }
}
