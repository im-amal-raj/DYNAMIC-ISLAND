import { Theme } from "../theme.slint";

export component IslandPill inherits Rectangle {
    background: Theme.glass-gradient;
    border-color: Theme.border-gradient;
    border-width: 1px;
    clip: true;
    
    // Smooth morphing border radius
    border-radius: self.height > 60px ? 24px : self.height / 2;
    animate border-radius { duration: Theme.spring-duration; easing: Theme.spring-easing; }
    
    // Smooth layout transitions
    animate width { duration: Theme.spring-duration; easing: Theme.spring-easing; }
    animate height { duration: Theme.spring-duration; easing: Theme.spring-easing; }
    
    @children
}
