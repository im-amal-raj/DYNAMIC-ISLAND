// PURPOSE: Compact pill media indicator with album art and mini visualizer
// INPUTS: media-state (MediaState), is-playing (bool), art-rotation (angle)
// USED BY: compact.slint

import { Theme } from "../theme.slint";

export component CompactMediaPill inherits VerticalLayout {
    in property <bool> has-album-art: false;
    in property <image> album-art: @image-url("");
    in property <angle> art-rotation: 0deg;
    in property <string> track-title: "";
    
    in-out property <bool> is-hovered: false;
    callback clicked();
    
    states [
        hover when ta.has-hover : {
            is-hovered: true;
        }
        normal when !ta.has-hover : {
            is-hovered: false;
        }
    ]
    
    alignment: center;
    Rectangle {
        width: root.is-hovered ? 160px : 52px;
        height: 36px;
        background: Theme.glass-gradient;
        border-color: Theme.border-gradient;
        border-width: 1px;
        border-radius: 18px;
        clip: true;
        
        animate width { duration: Theme.spring-duration; easing: Theme.spring-easing; }
        
        ta := TouchArea {
            width: 100%; height: 100%;
            clicked => { root.clicked(); }
        }
        
        HorizontalLayout {
            alignment: start;
            padding-left: 5px;
            padding-right: 7px;
            spacing: Theme.spacing-xs;
            
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px; height: 26px; border-radius: 13px;
                    background: rgba(255, 255, 255, 0.05);
                    clip: true;
                    
                    if root.has-album-art : Image {
                        width: 36px; height: 36px;
                        x: -5px; y: -5px;
                        source: root.album-art;
                        image-fit: cover;
                        transform-rotation: root.art-rotation;
                    }
                    if !root.has-album-art : Image {
                        width: 14px; height: 14px;
                        source: @image-url("../../../assets/music_fallback.svg");
                        image-fit: contain;
                        colorize: Theme.color-indigo;
                        x: 6px; y: 6px;
                    }
                }
            }
            
            if root.is-hovered : VerticalLayout {
                alignment: center;
                Text {
                    text: root.track-title;
                    color: Theme.text-primary; font-size: 11px; font-weight: 700;
                    overflow: elide;
                    width: 90px;
                }
            }

            // Alcove Mini Visualizer Bars
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: Theme.spacing-xs;
                    alignment: center;
                    height: 14px;

                    Rectangle {
                        width: 2px;
                        height: 4px + 8px * Math.abs(Math.sin(root.art-rotation * 4));
                        background: Theme.text-tertiary;
                        border-radius: 1px;
                        y: parent.height - self.height;
                    }
                    Rectangle {
                        width: 2px;
                        height: 3px + 10px * Math.abs(Math.sin(root.art-rotation * 6 + 45deg));
                        background: Theme.text-tertiary;
                        border-radius: 1px;
                        y: parent.height - self.height;
                    }
                    Rectangle {
                        width: 2px;
                        height: 5px + 7px * Math.abs(Math.sin(root.art-rotation * 3 - 30deg));
                        background: Theme.text-tertiary;
                        border-radius: 1px;
                        y: parent.height - self.height;
                    }
                }
            }
        }
    }
}
