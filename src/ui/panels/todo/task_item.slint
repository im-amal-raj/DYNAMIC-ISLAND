// PURPOSE: Individual task item row with completion toggle and delete action
// INPUTS: task (TaskItem), toggle/delete callbacks
// USED BY: todo_panel.slint

import { Theme } from "../../theme.slint";
import { TaskItem } from "../../types.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

export component TaskItemRow inherits Rectangle {
    in property <TaskItem> task;
    callback toggle-completion();
    callback delete();
    
    height: 48px;
    border-radius: Theme.card-radius-small;
    background: Theme.card-surface;
    border-width: 1px;
    border-color: Theme.border-color;
    
    // Priority Dot
    Rectangle {
        width: 8px; height: 8px; border-radius: 4px;
        x: Theme.spacing-md; y: (parent.height - self.height) / 2;
        background: root.task.priority == "High" ? Theme.color-red :
                   (root.task.priority == "Medium" ? Theme.color-orange : Theme.color-blue);
        opacity: root.task.is-completed ? 0.3 : 1.0;
    }

    // Checkbox Area
    TouchArea {
        width: 32px; height: 32px;
        x: Theme.spacing-md + 12px; y: (parent.height - self.height) / 2;
        clicked => { root.toggle-completion(); }
        
        Rectangle {
            width: 20px; height: 20px;
            border-radius: 10px;
            border-width: 2px;
            border-color: root.task.is-completed ? Theme.color-green : Theme.text-tertiary;
            background: root.task.is-completed ? Theme.color-green : transparent;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            
            if root.task.is-completed : Image {
                source: @image-url("../../../../assets/icons/check-circle-fill.svg");
                width: 14px; height: 14px;
                colorize: Theme.surface-primary;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
        }
    }

    // Task Title & Due Date
    VerticalBox {
        x: Theme.spacing-md + 12px + 32px + Theme.spacing-xs;
        width: parent.width - self.x - 40px; // Leave room for delete button
        alignment: center;
        spacing: 2px;
        
        Text {
            text: root.task.title;
            color: root.task.is-completed ? Theme.text-tertiary : Theme.text-primary;
            font-size: 13px;
            font-weight: 500;
            overflow: elide;
            
            Rectangle {
                width: root.task.is-completed ? parent.width : 0px;
                height: 1px;
                background: Theme.text-tertiary;
                y: parent.height / 2;
                x: 0;
                animate width { duration: Theme.standard-duration; easing: Theme.standard-easing; }
            }
        }
        
        if root.task.due_date_str != "" : Text {
            text: root.task.due_date_str;
            color: Theme.text-tertiary;
            font-size: 10px;
            font-weight: 500;
        }
    }
    
    // Delete Button (visible on hover)
    delete_ta := TouchArea {
        width: 32px; height: 32px;
        x: parent.width - self.width - Theme.spacing-sm;
        y: (parent.height - self.height) / 2;
        opacity: ta_row.has-hover || self.has-hover ? 1.0 : 0.0;
        animate opacity { duration: Theme.micro-duration; }
        clicked => { root.delete(); }
        
        Image {
            source: @image-url("../../../../assets/icons/trash-light.svg");
            width: Theme.icon-size-md; height: Theme.icon-size-md;
            colorize: parent.has-hover ? Theme.color-red : Theme.text-tertiary;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            animate colorize { duration: Theme.micro-duration; }
        }
    }
    
    ta_row := TouchArea {
        width: 100%; height: 100%;
        z: -1; // Let inner touch areas handle clicks
    }
}
