// PURPOSE: Expanded media playback panel with album art, track info, visualizer and controls
// INPUTS: media-state (MediaState), is-playing (bool), art-rotation (angle), volume-level (float)
// USED BY: src/island.slint

import { Theme } from "../theme.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { MediaState } from "../types.slint";
import { MediaVisualizer } from "media/media_visualizer.slint";
import { MediaControls } from "media/media_controls.slint";
import { MediaProgress } from "media/media_progress.slint";

export component MediaPanel inherits Rectangle {
    in property <MediaState> media-state;
    in-out property <bool> is-playing: false;
    in property <angle> art-rotation: 0deg;
    in-out property <float> volume-level: 0.0;

    callback set-volume(float);
    callback media-action(string);

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        alignment: center;
        padding-left: 20px; padding-right: 20px;
        padding-top: 15px; padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;

        // Album Art + Title / Artist stacked + Sound Visualizer
        HorizontalBox {
            padding: 0px;
            spacing: Theme.spacing-lg;
            alignment: space-between;
            
            HorizontalLayout {
                spacing: Theme.spacing-lg;
                alignment: start;
                
                // Rounded Album Art Card
                Rectangle {
                    width: 60px; height: 60px;
                    border-radius: Theme.card-radius;
                    background: Theme.card-surface;
                    border-width: 1px;
                    border-color: Theme.card-border;
                    clip: true;
                    
                    if root.media-state.has-album-art : Image {
                        width: 100%; height: 100%;
                        source: root.media-state.album-art;
                        image-fit: cover;
                    }
                    if !root.media-state.has-album-art : Image {
                        width: 24px; height: 24px;
                        source: @image-url("../../../assets/music_fallback.svg");
                        image-fit: contain;
                        colorize: Theme.text-secondary;
                        x: 18px; y: 18px;
                    }
                }
                
                // Track Metadata Stack
                VerticalBox {
                    alignment: center;
                    padding: 0px;
                    spacing: Theme.spacing-xs;
                    width: 160px;
                    
                    Text { 
                        text: root.media-state.track-title; 
                        color: Theme.text-primary; 
                        font-weight: 700; 
                        font-size: 14px; 
                        overflow: elide; 
                    }
                    Text { 
                        text: root.media-state.track-artist; 
                        color: Theme.text-secondary; 
                        font-weight: 500; 
                        font-size: 11px; 
                        overflow: elide; 
                    }
                }
            }
            
            // Sound Visualizer (5-bar equalizer wave animation)
            MediaVisualizer {
                is-playing: root.is-playing;
                art-rotation: root.art-rotation;
                y: (60px - self.height) / 2;
            }
        }

        // Progress Timeline Slider & Volume
        MediaProgress {
            media-state: root.media-state;
            volume-level <=> root.volume-level;
            set-volume(val) => { root.set-volume(val); }
        }
        
        // Playback controls row
        MediaControls {
            is-playing <=> root.is-playing;
            media-action(action) => { root.media-action(action); }
        }
    }
}
