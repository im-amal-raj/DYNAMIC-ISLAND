// PURPOSE: Quick system session action button (lock, sleep, reboot, shutdown)
// INPUTS: action-id (string), icon (image), action-color (color)
// USED BY: system_tray_panel.slint

import { Theme } from "../../theme.slint";

export component PowerButton inherits TouchArea {
    in property <string> action-id;
    in property <image> icon;
    in property <color> action-color;
    
    callback trigger-action(string);

    width: 28px; height: 28px;
    clicked => { root.trigger-action(root.action-id); }

    Rectangle {
        width: 100%; height: 100%;
        border-radius: self.width / 2;
        background: root.action-color;
        opacity: root.has-hover ? 0.25 : 0.15;
        border-width: 1px;
        border-color: root.action-color;
        animate opacity { duration: Theme.micro-duration; }
    }
    
    Image {
        width: Theme.icon-size-sm; height: Theme.icon-size-sm;
        source: root.icon;
        colorize: root.action-color;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}
