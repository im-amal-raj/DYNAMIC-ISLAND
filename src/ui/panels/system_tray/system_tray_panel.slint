import { Theme } from "../../theme.slint";
import { AppItem, IslandSection } from "../../types.slint";
import { SectionHeader } from "../../components/section_header.slint";
import { PowerButton } from "power_button.slint";
import { ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component SystemTrayPanel inherits Rectangle {
    in property <[AppItem]> system-tray-apps;
    in-out property <string> pending-power-action: "";
    in-out property <bool> show-power-confirm: false;

    callback power-action(string);
    callback activate-tray-item(string);

    public function focus_tray() {
        tray_focus.focus();
    }

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: Theme.panel-padding; 
        padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;
        
        SectionHeader {
            title: "SYSTEM TRAY";
            title-color: Theme.color-red;
            
            // Power Actions Group
            HorizontalBox {
                spacing: Theme.spacing-sm;
                padding: 0px;
                alignment: end;
                
                // 1. Lock Button (Info Blue)
                PowerButton {
                    action-id: "lock";
                    icon: @image-url("../../../../assets/icons/lock-light.svg");
                    action-color: Theme.color-blue;
                    trigger-action(id) => { root.pending-power-action = id; root.show-power-confirm = true; }
                }
                
                // 2. Suspend Button (Warning Orange)
                PowerButton {
                    action-id: "suspend";
                    icon: @image-url("../../../../assets/icons/moon-light.svg");
                    action-color: Theme.color-orange;
                    trigger-action(id) => { root.pending-power-action = id; root.show-power-confirm = true; }
                }
                
                // 3. Reboot Button (Success Green)
                PowerButton {
                    action-id: "reboot";
                    icon: @image-url("../../../../assets/icons/rotate-cw-light.svg");
                    action-color: Theme.color-green;
                    trigger-action(id) => { root.pending-power-action = id; root.show-power-confirm = true; }
                }
                
                // 4. Power Off Button (Error Red)
                PowerButton {
                    action-id: "poweroff";
                    icon: @image-url("../../../../assets/icons/power-light.svg");
                    action-color: Theme.color-red;
                    trigger-action(id) => { root.pending-power-action = id; root.show-power-confirm = true; }
                }
            }
        }
        
        // Tray applications slider
        ScrollView {
            height: 48px;
            viewport-width: 38px * root.system-tray-apps.length;
            
            HorizontalBox {
                padding: 0px;
                spacing: Theme.spacing-sm;
                alignment: start;
                
                for app in root.system-tray-apps : TouchArea {
                    width: 32px; height: 32px;
                    clicked => { root.activate-tray-item(app.id); }
                    
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.card-radius-small;
                        background: parent.has-hover ? Theme.card-surface-hover : Theme.card-surface;
                        animate background { duration: Theme.micro-duration; }
                        
                        if app.has-icon : Image {
                            width: Theme.icon-size-lg; height: Theme.icon-size-lg;
                            source: app.icon;
                            image-fit: contain;
                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                        }
                        if !app.has-icon : Text {
                            text: "✦";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: Theme.text-secondary;
                            width: 100%; height: 100%;
                        }
                    }
                }
            }
        }
    }

    tray_focus := FocusScope {
        key-pressed(event) => {
            if (root.show-power-confirm) {
                if (event.text == Key.Escape) {
                    root.show-power-confirm = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.power-action(root.pending-power-action);
                    root.show-power-confirm = false;
                    return accept;
                }
            }
            return reject;
        }
    }

    if root.show-power-confirm : Rectangle {
        width: 100%; height: 100%;
        x: 0px; y: 0px;
        z: 20;
        background: Theme.surface-overlay;
        border-radius: Theme.pill-radius;
        
        TouchArea { width: 100%; height: 100%; } // Consume clicks
        
        VerticalBox {
            alignment: center;
            spacing: Theme.spacing-md;
            
            Text {
                text: root.pending-power-action == "lock" ? "Lock session?" :
                      (root.pending-power-action == "suspend" ? "Suspend system?" :
                      (root.pending-power-action == "reboot" ? "Reboot system?" : "Power off system?"));
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            
            HorizontalBox {
                alignment: center;
                spacing: Theme.spacing-md;
                
                TouchArea {
                    width: 90px; height: 32px;
                    clicked => { root.show-power-confirm = false; }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.card-radius;
                        background: parent.has-hover ? Theme.card-surface-hover : Theme.card-surface;
                        border-width: 1px;
                        border-color: parent.has-hover ? Theme.card-border-hover : Theme.card-border;
                        animate background, border-color { duration: Theme.micro-duration; }
                        
                        Text { text: "Cancel"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                    }
                }
                
                ta_confirm := TouchArea {
                    width: 95px; height: 32px;
                    property <color> accent-col: root.pending-power-action == "poweroff" || root.pending-power-action == "reboot" ? Theme.color-red : Theme.color-blue;
                    clicked => {
                        root.power-action(root.pending-power-action);
                        root.show-power-confirm = false;
                    }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.card-radius;
                        background: ta_confirm.has-hover ? ta_confirm.accent-col : rgba(255, 255, 255, 0.1);
                        border-width: 1px;
                        border-color: ta_confirm.accent-col;
                        animate background { duration: Theme.micro-duration; }
                        
                        Text { text: "Confirm"; color: ta_confirm.has-hover ? #ffffff : ta_confirm.accent-col; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                    }
                }
            }
        }
    }
}
