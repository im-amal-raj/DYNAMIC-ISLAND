import { Theme } from "../theme.slint";
import { IslandSection } from "../types.slint";
import { CircularProgress } from "../components/circular_progress.slint";
import { GlassCard } from "../components/glass_card.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

export component SysMonitorPanel inherits Rectangle {
    in property <float> cpu-usage: 0.0;
    in property <float> memory-usage: 0.0;
    in property <string> cpu-large-ring-commands: "";
    in property <string> ram-large-ring-commands: "";
    
    in property <string> gpu-name: "";
    in property <float> gpu-usage: 0.0;
    in property <string> gpu-ring-commands: "";
    
    in property <string> igpu-name: "";
    in property <float> igpu-usage: 0.0;
    in property <string> igpu-ring-commands: "";
    
    in property <string> net-down-speed: "";
    in property <string> net-up-speed: "";

    in-out property <IslandSection> active-section;
    in-out property <length> target-width: 380px;
    in-out property <length> target-height: 340px;

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: 16px; padding-bottom: 48px;
        spacing: 10px;

        // Header
        HorizontalBox {
            padding: 0px;
            alignment: space-between;
        
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                
                Path {
                    width: 14px; height: 14px;
                    stroke: Theme.accent-info;
                    stroke-width: 1.5px;
                    commands: "M 3 3 L 13 3 L 13 13 L 3 13 Z M 5 1 L 5 3 M 8 1 L 8 3 M 11 1 L 11 3 M 15 5 L 13 5 M 15 8 L 13 8 M 15 11 L 13 11 M 5 15 L 5 13 M 8 15 L 8 13 M 11 15 L 11 13 M 1 5 L 3 5 M 1 8 L 3 8 M 1 11 L 3 11";
                    y: (parent.height - self.height) / 2;
                }
                Text { 
                    text: "SYSTEM HEALTH"; 
                    font-size: 11px; font-weight: 800; color: Theme.accent-info; 
                    vertical-alignment: center;
                }
            }
            
            TouchArea {
                clicked => {
                    root.active-section = IslandSection.Compact;
                    root.target-width = 220px;
                    root.target-height = 42px;
                }
                Text { text: "✕ Close"; font-size: 11px; color: Theme.accent-error; vertical-alignment: center; font-weight: 600; }
            }
        }

        // System Health Rings Grid Card
        GlassCard {
            VerticalBox {
                padding: 12px;
                spacing: 12px;
                
                // Row 1: CPU & RAM
                HorizontalLayout {
                    spacing: 24px;
                    alignment: space-around;
                    
                    // CPU Circle
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        padding: 0px;
                        
                        Text { text: "Processor (CPU)"; font-size: 10px; font-weight: 700; color: rgba(255, 255, 255, 0.75); horizontal-alignment: center; }
                        
                        Rectangle {
                            width: 50px; height: 50px;
                            CircularProgress {
                                width: 50px; height: 50px;
                                progress: root.cpu-usage;
                                viewbox-size: 50px;
                                track-commands: "M 25 2.5 A 22.5 22.5 0 1 1 24.99 2.5 Z";
                                ring-commands: root.cpu-large-ring-commands;
                                ring-width: 3.5px;
                                fill-color: root.cpu-usage > 0.8 ? Theme.accent-error : (root.cpu-usage > 0.5 ? Theme.accent-warning : Theme.accent-success);
                            }
                            Text {
                                text: Math.round(root.cpu-usage * 100) + "%";
                                font-size: 10px; font-weight: 800; color: #ffffff;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                    
                    // RAM Circle
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        padding: 0px;
                        
                        Text { text: "Memory (RAM)"; font-size: 10px; font-weight: 700; color: rgba(255, 255, 255, 0.75); horizontal-alignment: center; }
                        
                        Rectangle {
                            width: 50px; height: 50px;
                            CircularProgress {
                                width: 50px; height: 50px;
                                progress: root.memory-usage;
                                viewbox-size: 50px;
                                track-commands: "M 25 2.5 A 22.5 22.5 0 1 1 24.99 2.5 Z";
                                ring-commands: root.ram-large-ring-commands;
                                ring-width: 3.5px;
                                fill-color: root.memory-usage > 0.85 ? Theme.accent-error : (root.memory-usage > 0.5 ? Theme.accent-warning : Theme.accent-info);
                            }
                            Text {
                                text: Math.round(root.memory-usage * 100) + "%";
                                font-size: 10px; font-weight: 800; color: #ffffff;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                    }
                }
                
                // Row 2: GPUs (dGPU & iGPU)
                HorizontalLayout {
                    spacing: 24px;
                    alignment: space-around;
                    
                    // Dedicated GPU (dGPU)
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        padding: 0px;
                        
                        Text { text: root.gpu-name; font-size: 9px; font-weight: 700; color: rgba(255, 255, 255, 0.75); horizontal-alignment: center; width: 120px; overflow: elide; }
                        
                        Rectangle {
                            width: 50px; height: 50px;
                            CircularProgress {
                                width: 50px; height: 50px;
                                progress: root.gpu-usage;
                                viewbox-size: 50px;
                                track-commands: "M 25 2.5 A 22.5 22.5 0 1 1 24.99 2.5 Z";
                                ring-commands: root.gpu-ring-commands;
                                ring-width: 3.5px;
                                fill-color: #ff9f0a; // warm orange
                            }
                            Text {
                                text: Math.round(root.gpu-usage * 100) + "%";
                                font-size: 10px; font-weight: 800; color: #ffffff;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text { text: "Dedicated GPU"; font-size: 8px; color: rgba(255, 255, 255, 0.4); font-weight: 600; horizontal-alignment: center; }
                    }
                    
                    // Integrated GPU (iGPU)
                    VerticalBox {
                        alignment: center;
                        spacing: 4px;
                        padding: 0px;
                        
                        Text { text: root.igpu-name; font-size: 9px; font-weight: 700; color: rgba(255, 255, 255, 0.75); horizontal-alignment: center; width: 120px; overflow: elide; }
                        
                        Rectangle {
                            width: 50px; height: 50px;
                            CircularProgress {
                                width: 50px; height: 50px;
                                progress: root.igpu-usage;
                                viewbox-size: 50px;
                                track-commands: "M 25 2.5 A 22.5 22.5 0 1 1 24.99 2.5 Z";
                                ring-commands: root.igpu-ring-commands;
                                ring-width: 3.5px;
                                fill-color: Theme.accent-info;
                            }
                            Text {
                                text: Math.round(root.igpu-usage * 100) + "%";
                                font-size: 10px; font-weight: 800; color: #ffffff;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        Text { text: "Integrated GPU"; font-size: 8px; color: rgba(255, 255, 255, 0.4); font-weight: 600; horizontal-alignment: center; }
                    }
                }
            }
        }

        // Network Traffic Card
        Rectangle {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.06);
            
            VerticalBox {
                padding: 10px;
                spacing: 6px;
                
                HorizontalBox {
                    padding: 0px;
                    alignment: space-between;
                    Text { text: "Network Bandwidth Speed"; font-size: 11px; font-weight: 700; color: #ffffff; }
                    
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            Path {
                                width: 10px; height: 10px;
                                stroke: Theme.accent-success;
                                stroke-width: 1px;
                                commands: "M 5 2 L 5 8 M 3 6 L 5 8 L 7 6";
                                y: (parent.height - self.height) / 2;
                            }
                            Text { text: root.net-down-speed; font-size: 10px; font-weight: 700; color: Theme.accent-success; vertical-alignment: center; }
                        }
                        
                        HorizontalLayout {
                            spacing: 3px;
                            alignment: start;
                            Path {
                                width: 10px; height: 10px;
                                stroke: Theme.accent-info;
                                stroke-width: 1px;
                                commands: "M 5 8 L 5 2 M 3 4 L 5 2 L 7 4";
                                y: (parent.height - self.height) / 2;
                            }
                            Text { text: root.net-up-speed; font-size: 10px; font-weight: 700; color: Theme.accent-info; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }
}
