import { Theme } from "../theme.slint";
import { ClipItem } from "../types.slint";
import { GlassCard } from "../components/glass_card.slint";
import { HorizontalBox, VerticalBox, ScrollView, ListView } from "std-widgets.slint";
import { SectionHeader } from "../components/section_header.slint";
import { SearchField } from "../components/search_field.slint";
import { EmptyState } from "../components/empty_state.slint";

export component ClipboardPanel inherits Rectangle {
    in property <[ClipItem]> clipboard-history;
    
    callback clear-clipboard();
    callback search-clipboard(string);
    callback paste-clip(string);
    callback erase-clip(string);

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: Theme.panel-padding; padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;
    
        SectionHeader {
            title: "CLIPBOARD HISTORY";
            title-color: Theme.text-tertiary;
            
            Rectangle {
                width: 55px; height: 20px;
                border-radius: 6px;
                background: ta_clear.has-hover ? rgba(255, 59, 48, 0.25) : rgba(255, 59, 48, 0.15);
                animate background { duration: Theme.micro-duration; }
                Text { text: "CLEAR"; color: Theme.color-red; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                ta_clear := TouchArea { width: 100%; height: 100%; clicked => { root.clear-clipboard(); } }
            }
        }
        
        SearchField {
            placeholder-text: "Search clipboard...";
            changed text => {
                root.search-clipboard(self.text);
            }
        }

        if root.clipboard-history.length == 0 : EmptyState {
            icon: @image-url("../../../assets/icons/clipboard-light.svg");
            message: "Nothing copied yet";
        }
        
        if root.clipboard-history.length > 0 : ListView {
            for item in root.clipboard-history : ta := TouchArea {
                height: 62px;
                property <float> current-scale: self.pressed ? 0.95 : (self.has-hover ? 1.02 : 1.0);
                animate current-scale { duration: Theme.micro-duration; easing: Theme.standard-easing; }
                clicked => { root.paste-clip(item.id); }
                
                GlassCard {
                    interactive: true;
                    width: parent.width * parent.current-scale;
                    height: 54px * parent.current-scale;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    
                    // Inline Erase Button on Hover
                    if ta.has-hover : Rectangle {
                        width: 22px; height: 22px;
                        border-radius: 11px;
                        background: erase_ta.has-hover ? rgba(255, 59, 48, 0.2) : transparent;
                        x: parent.width - self.width - Theme.spacing-md;
                        y: (parent.height - self.height) / 2;
                        z: 10;
                        
                        Image {
                            width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/x-light.svg");
                            colorize: erase_ta.has-hover ? Theme.color-red : Theme.text-tertiary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        
                        erase_ta := TouchArea {
                            clicked => {
                                root.erase-clip(item.id);
                            }
                        }
                    }
                    
                    HorizontalBox {
                        padding: Theme.spacing-md;
                        padding-right: 36px;
                        alignment: start;
                        spacing: Theme.spacing-md;
                        
                        if item.has_image : Image {
                            width: 34px; height: 34px;
                            source: item.image_data;
                            image-fit: cover;
                        }
                        if !item.has_image : Image {
                            width: 16px; height: 16px;
                            source: @image-url("../../../assets/icons/clipboard-light.svg");
                            colorize: Theme.text-secondary;
                        }
                        
                        Text { 
                            text: item.text; 
                            color: Theme.text-primary; 
                            font-size: 13px; 
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
