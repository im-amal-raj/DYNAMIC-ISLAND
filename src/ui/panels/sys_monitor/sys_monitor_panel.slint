import { Theme } from "../../theme.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { SectionHeader } from "../../components/section_header.slint";
import { MetricCard } from "metric_card.slint";

export component SysMonitorPanel inherits Rectangle {
    in property <float> cpu-usage: 0.0;
    in property <float> memory-usage: 0.0;
    in property <string> cpu-large-ring-commands: "";
    in property <string> ram-large-ring-commands: "";
    
    in property <string> gpu-name: "";
    in property <float> gpu-usage: 0.0;
    in property <string> gpu-ring-commands: "";
    
    in property <string> igpu-name: "";
    in property <float> igpu-usage: 0.0;
    in property <string> igpu-ring-commands: "";
    
    in property <string> net-down-speed: "";
    in property <string> net-up-speed: "";

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: Theme.panel-padding; 
        padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;

        SectionHeader {
            title: "SYSTEM METRICS";
            title-color: Theme.color-teal;
        }

        // 2x2 Grid of Metrics
        VerticalBox {
            padding: 0px;
            spacing: Theme.spacing-sm;

            // Row 1: CPU & RAM
            HorizontalBox {
                padding: 0px;
                spacing: Theme.spacing-sm;

                MetricCard {
                    title: "CPU";
                    icon: @image-url("../../../../assets/icons/cpu-light.svg");
                    usage: root.cpu-usage;
                    ring-commands: root.cpu-large-ring-commands;
                }

                MetricCard {
                    title: "RAM";
                    icon: @image-url("../../../../assets/icons/layers-light.svg"); // Memory-like icon
                    usage: root.memory-usage;
                    ring-commands: root.ram-large-ring-commands;
                }
            }

            // Row 2: GPUs (or Network if only 1 GPU)
            HorizontalBox {
                padding: 0px;
                spacing: Theme.spacing-sm;

                MetricCard {
                    title: "GPU 1";
                    icon: @image-url("../../../../assets/icons/monitor-light.svg");
                    usage: root.gpu-usage;
                    ring-commands: root.gpu-ring-commands;
                }

                if root.igpu-name != "" : MetricCard {
                    title: "GPU 2";
                    icon: @image-url("../../../../assets/icons/monitor-light.svg");
                    usage: root.igpu-usage;
                    ring-commands: root.igpu-ring-commands;
                }

                // If only 1 GPU, show Network instead
                if root.igpu-name == "" : Rectangle {
                    border-radius: Theme.card-radius;
                    background: Theme.card-surface;
                    border-width: 1px;
                    border-color: Theme.border-color;
                    
                    VerticalBox {
                        padding: Theme.spacing-md;
                        spacing: Theme.spacing-sm;
                        alignment: center;

                        HorizontalBox {
                            padding: 0px;
                            spacing: Theme.spacing-xs;
                            Image {
                                source: @image-url("../../../../assets/icons/wifi-light.svg");
                                width: Theme.icon-size-sm; height: Theme.icon-size-sm; colorize: Theme.text-secondary;
                            }
                            Text { text: "NETWORK"; color: Theme.text-secondary; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                        }

                        VerticalBox {
                            padding: 0px;
                            spacing: 4px;
                            
                            HorizontalBox {
                                padding: 0px;
                                alignment: space-between;
                                Text { text: "↓ " + root.net-down-speed; color: Theme.color-blue; font-size: 13px; font-weight: 700; }
                            }
                            HorizontalBox {
                                padding: 0px;
                                alignment: space-between;
                                Text { text: "↑ " + root.net-up-speed; color: Theme.color-orange; font-size: 13px; font-weight: 700; }
                            }
                        }
                    }
                }
            }
        }
    }
}
