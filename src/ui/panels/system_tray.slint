import { Theme } from "../theme.slint";
import { AppItem, IslandSection } from "../types.slint";
import { ScrollView, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { GlassCard } from "../components/glass_card.slint";

export component SystemTrayPanel inherits Rectangle {
    in property <[AppItem]> system-tray-apps;
    in-out property <string> pending-power-action: "";
    in-out property <bool> show-power-confirm: false;

    callback power-action(string);
    callback activate-tray-item(string);

    public function focus_tray() {
        tray_focus.focus();
    }

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: 16px; padding-bottom: 48px;
        spacing: 12px;
        
        HorizontalBox {
            padding: 0px;
            alignment: space-between;
            Text { text: "SYSTEM TRAY"; color: #ff375f; font-size: 10px; font-weight: 800; letter-spacing: 1px; vertical-alignment: center; }
            
            // Power Actions Group
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                
                // 1. Lock Button (Info Blue)
                TouchArea {
                    width: 24px; height: 24px;
                    clicked => { root.pending-power-action = "lock"; root.show-power-confirm = true; }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: rgba(10, 132, 255, 0.1);
                        border-width: 1px;
                        border-color: rgba(10, 132, 255, 0.2);
                        
                        Image {
                            width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/lock.svg");
                            colorize: Theme.accent-info;
                            x: 5px; y: 5px;
                        }
                    }
                }
                // 2. Suspend Button (Warning Orange)
                TouchArea {
                    width: 24px; height: 24px;
                    clicked => { root.pending-power-action = "suspend"; root.show-power-confirm = true; }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: rgba(255, 159, 10, 0.1);
                        border-width: 1px;
                        border-color: rgba(255, 159, 10, 0.2);
                        
                        Image {
                            width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/moon.svg");
                            colorize: Theme.accent-warning;
                            x: 5px; y: 5px;
                        }
                    }
                }
                // 3. Reboot Button (Success Green)
                TouchArea {
                    width: 24px; height: 24px;
                    clicked => { root.pending-power-action = "reboot"; root.show-power-confirm = true; }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: rgba(48, 209, 88, 0.1);
                        border-width: 1px;
                        border-color: rgba(48, 209, 88, 0.2);
                        
                        Image {
                            width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/rotate-cw.svg");
                            colorize: Theme.accent-success;
                            x: 5px; y: 5px;
                        }
                    }
                }
                // 4. Power Off Button (Error Red)
                TouchArea {
                    width: 24px; height: 24px;
                    clicked => { root.pending-power-action = "poweroff"; root.show-power-confirm = true; }
                    Rectangle {
                        width: 24px; height: 24px;
                        border-radius: 12px;
                        background: rgba(255, 59, 48, 0.1);
                        border-width: 1px;
                        border-color: rgba(255, 59, 48, 0.2);
                        
                        Image {
                            width: 14px; height: 14px;
                            source: @image-url("../../../assets/icons/power.svg");
                            colorize: Theme.accent-error;
                            x: 5px; y: 5px;
                        }
                    }
                }
            }
        }
        
        // Tray applications slider
        ScrollView {
            height: 48px;
            viewport-width: 38px * root.system-tray-apps.length;
            
            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                alignment: start;
                
                for app in root.system-tray-apps : Rectangle {
                    width: 30px; height: 30px;
                    border-radius: 8px;
                    background: rgba(255, 255, 255, 0.05);
                    
                    if app.has-icon : Image {
                        width: 24px; height: 24px;
                        source: app.icon;
                        image-fit: contain;
                    }
                    if !app.has-icon : Text {
                        text: "✦";
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        color: #8e8e93;
                    }
                    TouchArea {
                        clicked => { root.activate-tray-item(app.id); }
                    }
                }
            }
        }
    }

    tray_focus := FocusScope {
        key-pressed(event) => {
            if (root.show-power-confirm) {
                if (event.text == Key.Escape) {
                    root.show-power-confirm = false;
                    return accept;
                }
                if (event.text == Key.Return) {
                    root.power-action(root.pending-power-action);
                    root.show-power-confirm = false;
                    return accept;
                }
            }
            return reject;
        }
    }

    if root.show-power-confirm : GlassCard {
        interactive: false;
        width: 100%; height: 100%;
        x: 0px; y: 0px;
        z: 20;
        
        VerticalBox {
            alignment: center;
            spacing: 16px;
            
            Text {
                text: root.pending-power-action == "lock" ? "Lock session?" :
                      (root.pending-power-action == "suspend" ? "Suspend system?" :
                      (root.pending-power-action == "reboot" ? "Reboot system?" : "Power off system?"));
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
            }
            
            HorizontalBox {
                alignment: center;
                spacing: 12px;
                
                ta_cancel := TouchArea {
                    property <bool> is-hover: self.has-hover;
                    clicked => {
                        root.show-power-confirm = false;
                    }
                    Rectangle {
                        width: 90px; height: 32px;
                        border-radius: 16px;
                        background: ta_cancel.is-hover ? Theme.card-surface-hover : Theme.card-surface;
                        border-width: 1px;
                        border-color: ta_cancel.is-hover ? Theme.card-border-hover : Theme.card-border;
                        animate background, border-color { duration: Theme.fade-duration; }
                        
                        Text { text: "Cancel"; color: Theme.text-secondary; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                
                ta_confirm := TouchArea {
                    property <bool> is-hover: self.has-hover;
                    property <color> accent-col: root.pending-power-action == "poweroff" || root.pending-power-action == "reboot" ? Theme.accent-error : Theme.accent-info;
                    clicked => {
                        root.power-action(root.pending-power-action);
                        root.show-power-confirm = false;
                    }
                    Rectangle {
                        width: 95px; height: 32px;
                        border-radius: 16px;
                        background: ta_confirm.is-hover ? ta_confirm.accent-col : rgba(255, 255, 255, 0.1);
                        border-width: 1px;
                        border-color: ta_confirm.accent-col;
                        animate background { duration: Theme.fade-duration; }
                        
                        Text { text: "Confirm"; color: ta_confirm.is-hover ? #ffffff : ta_confirm.accent-col; font-size: 11px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
