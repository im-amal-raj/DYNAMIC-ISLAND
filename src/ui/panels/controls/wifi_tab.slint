// PURPOSE: Wi-Fi network scanner and connection management tab
// INPUTS: wifi-enabled, wifi-networks, connect/disconnect callbacks
// USED BY: controls_panel.slint

import { Theme } from "../../theme.slint";
import { WifiNetwork } from "../../types.slint";
import { BaseDeviceListTab } from "base_device_list_tab.slint";
import { ListItem } from "../../components/list_item.slint";

export component WifiTab inherits Rectangle {
    in property <bool> wifi-enabled: false;
    in property <[WifiNetwork]> wifi-networks;
    
    callback toggle-wifi(bool);
    callback scan-wifi();
    callback disconnect-wifi();
    callback connect-wifi(string, string);

    BaseDeviceListTab {
        title: "Wi-Fi";
        status-text: root.wifi-enabled ? "On" : "Off";
        is-enabled: root.wifi-enabled;
        is-empty: root.wifi-networks.length == 0;
        empty-icon: @image-url("../../../../assets/icons/wifi-light.svg");
        empty-message: "No networks found";
        
        toggled(val) => { root.toggle-wifi(val); }
        
        for net in root.wifi-networks : ListItem {
            icon: @image-url("../../../../assets/icons/wifi-light.svg");
            title: net.ssid;
            subtitle: "Signal: " + net.signal + "%";
            status-text: net.connected ? "Connected" : "";
            status-color: Theme.color-green;
            is-active: net.connected;
            
            clicked => {
                if net.connected {
                    root.disconnect-wifi();
                } else {
                    root.connect-wifi(net.ssid, "");
                }
            }
        }
    }
}
