// PURPOSE: Bluetooth connectivity management tab with device list and pairing
// INPUTS: bluetooth-enabled, bluetooth-devices, connect/disconnect callbacks
// USED BY: controls_panel.slint

import { Theme } from "../../theme.slint";
import { BluetoothDevice } from "../../types.slint";
import { BaseDeviceListTab } from "base_device_list_tab.slint";
import { ListItem } from "../../components/list_item.slint";

export component BluetoothTab inherits Rectangle {
    in property <bool> bluetooth-enabled: false;
    in property <[BluetoothDevice]> bluetooth-devices;
    
    callback toggle-bluetooth(bool);
    callback scan-bluetooth();
    callback disconnect-bluetooth(string);
    callback connect-bluetooth(string);

    BaseDeviceListTab {
        title: "Bluetooth";
        status-text: root.bluetooth-enabled ? "On" : "Off";
        is-enabled: root.bluetooth-enabled;
        is-empty: root.bluetooth-devices.length == 0;
        empty-icon: @image-url("../../../../assets/icons/bluetooth-light.svg");
        empty-message: "No devices found";
        
        toggled(val) => { root.toggle-bluetooth(val); }
        
        for device in root.bluetooth-devices : ListItem {
            icon: @image-url("../../../../assets/icons/bluetooth-light.svg");
            title: device.name;
            subtitle: "";
            status-text: device.connected ? "Connected" : "";
            status-color: Theme.color-blue;
            is-active: device.connected;
            
            clicked => {
                if device.connected {
                    root.disconnect-bluetooth(device.mac);
                } else {
                    root.connect-bluetooth(device.mac);
                }
            }
        }
    }
}
