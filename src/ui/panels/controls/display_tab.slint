// PURPOSE: Display brightness slider tab
// INPUTS: brightness-level (float), set-brightness callback
// USED BY: controls_panel.slint

import { Theme } from "../../theme.slint";
import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { SectionHeader } from "../../components/section_header.slint";
import { SliderControl } from "../../components/slider_control.slint";

export component DisplayTab inherits Rectangle {
    in property <float> brightness-level: 0.0;
    
    callback set-brightness(float);

    VerticalBox {
        spacing: Theme.spacing-sm;
        padding: 0px;

        SectionHeader {
            title: "Display Brightness";
        }
        
        SliderControl {
            icon-source: @image-url("../../../../assets/icons/sun-light.svg");
            value: root.brightness-level;
            changed(val) => { root.set-brightness(val); }
        }
    }
}
