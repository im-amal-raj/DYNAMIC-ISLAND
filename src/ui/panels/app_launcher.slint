// PURPOSE: Desktop application launcher with fuzzy query filtering
// INPUTS: app-results ([AppItem]), launch-app callback
// USED BY: src/island.slint

import { Theme } from "../theme.slint";
import { AppItem } from "../types.slint";
import { HorizontalBox, VerticalBox, ScrollView, ListView } from "std-widgets.slint";
import { SearchField } from "../components/search_field.slint";
import { EmptyState } from "../components/empty_state.slint";

export component AppLauncherPanel inherits Rectangle {
    in property <[AppItem]> app-results;
    forward-focus: app_input;
    callback search-apps(string);
    callback launch-app(string);
    
    public function focus_launcher() {
        app_input.focus();
    }

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: Theme.panel-padding; padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;
    
        app_input := SearchField {
            placeholder-text: "Search apps...";
            changed text => {
                root.search-apps(self.text);
            }
            accepted => {
                if root.app-results.length > 0 {
                    root.launch-app(root.app-results[0].exec_cmd);
                }
            }
        }
        
        if root.app-results.length == 0 : EmptyState {
            icon: @image-url("../../../assets/icons/grid-light.svg");
            message: "No apps match...";
        }
        
        if root.app-results.length > 0 : ListView {
            for item in root.app-results : ta_app := TouchArea {
                height: 44px;
                clicked => { root.launch-app(item.exec_cmd); }
                
                Rectangle {
                    border-radius: Theme.card-radius;
                    background: ta_app.has-hover ? Theme.card-surface-hover : Theme.card-surface;
                    border-width: 1px;
                    border-color: ta_app.has-hover ? Theme.card-border-hover : Theme.card-border;
                    animate background, border-color { duration: Theme.micro-duration; }
                    
                    HorizontalBox {
                        padding: Theme.spacing-sm;
                        spacing: Theme.spacing-md;
                        alignment: start;
                        
                        if item.has-icon : Image {
                            width: 28px; height: 28px;
                            source: item.icon;
                            image-fit: contain;
                        }
                        if !item.has-icon : Rectangle {
                            width: 28px; height: 28px;
                            border-radius: 8px;
                            background: rgba(255, 255, 255, 0.1);
                            Image {
                                source: @image-url("../../../assets/icons/app-generic-light.svg");
                                width: 14px; height: 14px;
                                colorize: Theme.text-secondary;
                            }
                        }
                        
                        Text { text: item.name; color: Theme.text-primary; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
    }
}
