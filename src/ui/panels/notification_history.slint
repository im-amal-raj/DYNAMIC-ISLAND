// PURPOSE: Notification center history panel with dismiss and clear-all actions
// INPUTS: notifications ([NotifItem]), clear-all callback
// USED BY: src/island.slint

import { Theme } from "../theme.slint";
import { NotifItem } from "../types.slint";
import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { SectionHeader } from "../components/section_header.slint";
import { EmptyState } from "../components/empty_state.slint";

export component NotificationHistoryPanel inherits Rectangle {
    in property <[NotifItem]> notif-history;
    callback clear-notif-history();

    TouchArea {
        width: 100%; height: 100%;
        clicked => {}
    }

    VerticalBox {
        width: 100%; height: 100%;
        padding: Theme.panel-padding; padding-bottom: Theme.panel-padding-bottom;
        spacing: Theme.spacing-md;
    
        SectionHeader {
            title: "NOTIFICATIONS";
            title-color: Theme.color-blue;
            
            Rectangle {
                width: 45px; height: 18px;
                border-radius: 4px;
                background: ta_clear_notifs.has-hover ? rgba(255, 59, 48, 0.2) : rgba(255, 59, 48, 0.1);
                Text { text: "CLEAR"; color: Theme.color-red; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%; }
                ta_clear_notifs := TouchArea { width: 100%; height: 100%; clicked => { root.clear-notif-history(); } }
            }
        }
        
        if root.notif-history.length == 0 : EmptyState {
            icon: @image-url("../../../assets/icons/bell-light.svg");
            message: "No notifications";
        }
        
        if root.notif-history.length > 0 : ScrollView {
            height: 160px;
            VerticalBox {
                spacing: Theme.spacing-sm;
                alignment: start;
                for item in root.notif-history : Rectangle {
                    height: 50px;
                    border-radius: Theme.card-radius-small;
                    background: Theme.card-surface;
                    
                    HorizontalBox {
                        padding: Theme.spacing-sm;
                        alignment: start;
                        spacing: Theme.spacing-md;
                        
                        if item.has-icon : Image {
                            width: 34px; height: 34px;
                            source: item.icon;
                            image-fit: contain;
                        }
                        if !item.has-icon : Rectangle {
                            width: 34px; height: 34px;
                            border-radius: 4px;
                            background: rgba(255, 255, 255, 0.1);
                            Image { 
                                width: 14px; height: 14px; 
                                source: @image-url("../../../assets/icons/bell-light.svg"); 
                                colorize: Theme.text-primary; 
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                        }
                        VerticalBox {
                            spacing: Theme.spacing-xs;
                            alignment: center;
                            Text { text: item.summary; color: Theme.text-primary; font-size: 13px; font-weight: 700; overflow: elide; }
                            Text { text: item.body; color: Theme.text-secondary; font-size: 11px; overflow: elide; }
                        }
                    }
                }
            }
        }
    }
}
