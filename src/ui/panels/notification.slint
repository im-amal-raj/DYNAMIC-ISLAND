import { Theme } from "../theme.slint";
import { IslandSection } from "../types.slint";
import { HorizontalBox, VerticalBox } from "std-widgets.slint";

export component NotificationPanel inherits Rectangle {
    in property <bool> has-notif-icon: false;
    in property <image> notif-icon: @image-url("");
    in property <string> notif-app-name: "";
    in property <string> notif-summary: "";
    in property <string> notif-body: "";
    
    in-out property <IslandSection> active-section;

    clip: true;
    
    TouchArea {
        width: 100%; height: 100%;
        clicked => {
            root.active-section = IslandSection.Compact;
        }
    }
    
    VerticalBox {
        width: 100%; height: 100%;
        y: root.active-section == IslandSection.Notification ? 0px : -10px;
        animate y { duration: Theme.standard-duration; easing: Theme.standard-easing; }
        alignment: center;
        padding: Theme.panel-padding;
        spacing: Theme.spacing-sm;
        
        HorizontalBox {
            alignment: start;
            spacing: Theme.spacing-sm;
            
            if root.has-notif-icon : Image {
                width: 16px; height: 16px;
                source: root.notif-icon;
                image-fit: contain;
            }
            if !root.has-notif-icon : Rectangle {
                width: 16px; height: 16px;
                border-radius: 4px;
                background: Theme.color-blue;
                Image { 
                    width: 14px; height: 14px; 
                    source: @image-url("../../../assets/icons/bell-light.svg"); 
                    colorize: Theme.text-primary; 
                    x: 1px; y: 1px;
                }
            }
            Text { text: root.notif-app-name; color: Theme.color-blue; font-size: 11px; font-weight: 800; letter-spacing: 1px; vertical-alignment: center; }
        }
        
        VerticalBox {
            spacing: Theme.spacing-xs;
            Text { text: root.notif-summary; color: Theme.text-primary; font-size: 14px; font-weight: 700; overflow: elide; }
            Text { text: root.notif-body; color: Theme.text-secondary; font-size: 12px; overflow: elide; wrap: word-wrap; }
        }
    }
}
