// PURPOSE: Rest-state compact island pill with clock, battery, and media status
// INPUTS: clock-time, battery-level, media-state, has-active-media
// USED BY: src/island.slint

import { Theme } from "../theme.slint";
import { IslandSection, HardwareStats, MediaState } from "../types.slint";
import { CircularProgress } from "../components/circular_progress.slint";
import { CompactMediaPill } from "../components/compact_media_pill.slint";
import { HorizontalBox } from "std-widgets.slint";

export component CompactPanel inherits HorizontalLayout {
    in property <MediaState> media-state;
    in property <HardwareStats> hardware-stats;
    in property <bool> is-playing: false;
    in property <bool> has-new-notification: false;
    in property <bool> show-hud-peek: false;
    in property <string> hud-peek-icon: "volume";
    in property <float> hud-peek-value: 50.0;
    in property <string> current-date-string: "";
    in property <string> current-time-string: "";
    in property <string> peek-notif-summary: "";
    in property <image> peek-notif-icon: @image-url("");
    in property <angle> art-rotation: 0deg;

    in-out property <IslandSection> active-section;
    in-out property <bool> right-pill-hovered: false;

    alignment: center;
    spacing: root.is-playing ? 10px : 0px;
    
    // Left Pill (Time/Date & CPU/Memory status)
    Rectangle {
        width: root.is-playing ? (parent.width - (root.right-pill-hovered ? 172px : 64px)) : parent.width;
        height: parent.height;
        background: Theme.glass-gradient;
        border-color: Theme.border-gradient;
        border-width: 1px;
        border-radius: self.height / 2;
        
        animate width { duration: Theme.spring-duration; easing: Theme.spring-easing; }
        
        HorizontalBox {
            alignment: center;
            spacing: 8px;
            
            // Transient Volume / Brightness Micro HUD Peek
            if root.show-hud-peek : HorizontalLayout {
                spacing: 8px;
                alignment: center;
                
                Image {
                    width: 14px; height: 14px;
                    source: root.hud-peek-icon == "volume" ? @image-url("../../../assets/icons/volume-2-light.svg") : @image-url("../../../assets/icons/sun-light.svg");
                    colorize: Theme.text-primary;
                    vertical-alignment: center;
                }
                
                Rectangle {
                    width: 76px; height: 6px;
                    border-radius: 3px;
                    background: rgba(255, 255, 255, 0.15);
                    clip: true;
                    
                    Rectangle {
                        width: parent.width * Math.max(0.0, Math.min(1.0, root.hud-peek-value / 100.0));
                        height: 100%;
                        background: Theme.text-primary;
                        border-radius: 3px;
                        animate width { duration: 150ms; easing: ease-out; }
                    }
                }
                
                Text {
                    text: Math.round(root.hud-peek-value) + "%";
                    color: Theme.text-primary;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            if !root.show-hud-peek && !root.has-new-notification : HorizontalLayout {
                spacing: 8px;
                alignment: center;
                
                // Sleek Hardware Gauge
                HorizontalBox {
                    spacing: Theme.spacing-xs;
                    alignment: center;
                    padding: 0px;

                    cpu_ta := TouchArea {
                        width: 48px; height: 24px;
                        clicked => { root.active-section = IslandSection.SysMonitor; }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 4px;
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../../assets/icons/cpu-light.svg");
                                    width: 14px; height: 14px;
                                    colorize: root.hardware-stats.cpu-usage > 0.8 ? Theme.color-red : Theme.text-tertiary;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: Math.round(root.hardware-stats.cpu-usage * 100) + "%";
                                    color: Theme.text-secondary;
                                    font-size: 11px; font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Clock / Stats Text (Transitions on hover)
                if !cpu_ta.has-hover : HorizontalBox {
                    spacing: Theme.spacing-xs;
                    alignment: center;
                    padding: 0px;
                    
                    Text {
                        text: root.current-date-string;
                        color: Theme.text-secondary;
                        font-size: 11px; font-weight: 500;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.current-time-string;
                        color: Theme.text-primary;
                        font-size: 11px; font-weight: 800;
                        vertical-alignment: center;
                    }
                }
                
                if cpu_ta.has-hover : Text {
                    text: "CPU: " + Math.round(root.hardware-stats.cpu-usage * 100) + "%  |  RAM: " + Math.round(root.hardware-stats.memory-usage * 100) + "%";
                    color: Theme.text-secondary;
                    font-size: 11px; font-weight: 700;
                    vertical-alignment: center;
                    animate color { duration: Theme.micro-duration; }
                }
            }
            
            if !root.show-hud-peek && root.has-new-notification : HorizontalBox {
                spacing: Theme.spacing-xs;
                alignment: center;
                Image {
                    width: 16px; height: 16px;
                    source: root.peek-notif-icon;
                }
                Text {
                    text: root.peek-notif-summary;
                    color: Theme.color-blue; font-size: 11px; font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
    
    // Right Pill (Detached Circle containing spinning art)
    if root.is-playing : CompactMediaPill {
        has-album-art: root.media-state.has-album-art;
        album-art: root.media-state.album-art;
        art-rotation: root.art-rotation;
        track-title: root.media-state.track-title;
        is-hovered <=> root.right-pill-hovered;
        clicked => {
            root.active-section = IslandSection.Media;
        }
    }
}
