// PURPOSE: Shared UI data structures and enumeration definitions
// INPUTS: None (pure data model structs and enums)
// USED BY: island.slint, panels, and Rust backend bindings

export enum IslandSection {
    Compact,
    Media,
    Clipboard,
    Notification,
    SysControls,
    AppLauncher,
    SystemTray,
    NotificationHistory,
    TodoManager,
    CalendarView,
    SysMonitor
}

export struct TaskItem {
    id: int,
    title: string,
    due_date_str: string,
    due_time_str: string,
    is_completed: bool,
    priority: string,
}

export struct CalendarDay {
    text: string,
    has_event: bool,
}

export struct WifiNetwork {
    ssid: string,
    signal: int,
    connected: bool,
}

export struct BluetoothDevice {
    name: string,
    mac: string,
    connected: bool,
}

export struct AudioDevice {
    id: string,
    name: string,
    is_default: bool,
}

export struct ClipItem {
    id: string,
    text: string,
    has_image: bool,
    image_data: image,
}

export struct NotifItem {
    id: string,
    app_name: string,
    summary: string,
    body: string,
    has_icon: bool,
    icon: image,
}

export struct AppItem {
    id: string,
    name: string,
    exec_cmd: string,
    has_icon: bool,
    icon: image,
}

export struct MediaState {
    track_title: string,
    track_artist: string,
    has_album_art: bool,
    album_art: image,
    is_playing: bool,
    track_position_str: string,
    track_duration_str: string,
    track_progress: float,
}

export struct HardwareStats {
    cpu_usage: float,
    memory_usage: float,
    net_down_speed: string,
    net_up_speed: string,
    gpu_name: string,
    gpu_usage: float,
    gpu_ring_commands: string,
    igpu_name: string,
    igpu_usage: float,
    igpu_ring_commands: string,
    cpu_ring_commands: string,
    ram_ring_commands: string,
    cpu_large_ring_commands: string,
    ram_large_ring_commands: string,
}
